# Shared secret the mobile app sends as X-App-Key
APP_KEY=dev-app-key

# gemini | llm | brave | google_cse | mock
# gemini/llm asks Gemini (or LLM_MODEL) for lyrics in the selected script.
SEARCH_PROVIDER=gemini

BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# LiteLLM model id. For Gemini lyrics use gemini/gemini-2.0-flash and GEMINI_API_KEY.
# Set to none to skip LLM (mock search still works; lyrics search will 503).
LLM_MODEL=gemini/gemini-2.0-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

CACHE_DIR=./.cache
CORS_ORIGINS=*
LOG_LEVEL=INFO
