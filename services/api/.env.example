# Shared secret the mobile app sends as X-App-Key
APP_KEY=dev-app-key

# brave | google_cse | mock
SEARCH_PROVIDER=mock

BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# LiteLLM model id, e.g. gpt-4o-mini, claude-3-5-haiku-latest, gemini/gemini-2.0-flash
# Set to none to skip LLM and use the heuristic verse extractor / skip translation.
LLM_MODEL=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

CACHE_DIR=./.cache
CORS_ORIGINS=*
LOG_LEVEL=INFO
